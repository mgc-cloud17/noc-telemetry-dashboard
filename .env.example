# Copiar a .env y ajustar. NUNCA versionar .env

# true = telemetría simulada (sin GNS3); false = sondeo real ICMP + SNMPv2c
SIMULATION_MODE=true

# Servidor ASGI
HOST=0.0.0.0
PORT=8000

# Temporización de sondeo (segundos)
POLL_INTERVAL_SECONDS=4
POLL_TIMEOUT_SECONDS=1.5
SNMP_TIMEOUT_SECONDS=3.0
SNMP_RETRIES=1

# SNMPv2c (valores ficticios para desarrollo)
SNMP_COMMUNITY=change-me
SNMP_PORT=161

# Umbrales operativos (ajustados para virtualización QEMU/VMware en GNS3)
LATENCY_DEGRADED_MS=150
CPU_DEGRADED_PERCENT=85
LINK_MAX_KBPS=1000000

# Opciones avanzadas
ICMP_PRIVILEGED=false
SIMULATION_SEED=
